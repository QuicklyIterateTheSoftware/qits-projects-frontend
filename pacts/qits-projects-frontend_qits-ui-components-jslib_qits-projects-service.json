              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/projects/api/projects/00000000-0000-4000-8000-000000000001/work/briefs",
        "query": {
          "id": [
            "contract-00000001-2,contract-00000001-1,contract-00000001-999"
          ]
        }
      },
      "response": {
        "body": {
